<Project>
  <PropertyGroup>
    <!-- Zynara.Data uses the Cosmos SDK's System.Text.Json serializer
         (UseSystemTextJsonSerializerWithOptions); the SDK's build check still
         wants Newtonsoft referenced. Suppress it repo-wide since projects that
         transitively pick up Cosmos don't inherit a per-project setting. -->
    <AzureCosmosDisableNewtonsoftJsonCheck>true</AzureCosmosDisableNewtonsoftJsonCheck>
  </PropertyGroup>
</Project>
