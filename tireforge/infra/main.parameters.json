{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "projectName": {
      "value": "${FOUNDRY_PROJECT_NAME=factory-project}"
    },
    "modelDeploymentName": {
      "value": "${MODEL_DEPLOYMENT_NAME=gpt-5.4}"
    },
    "modelName": {
      "value": "${MODEL_NAME=gpt-5.4}"
    },
    "modelVersion": {
      "value": "${MODEL_VERSION=2026-03-05}"
    },
    "modelCapacity": {
      "value": "${MODEL_CAPACITY=10}"
    },
    "deployCompute": {
      "value": "${DEPLOY_COMPUTE=true}"
    },
    "deployDatabase": {
      "value": "${DEPLOY_DATABASE=true}"
    },
    "sqlAdminObjectId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "agentsMode": {
      "value": "${TIREFORGE_AGENTS=foundry}"
    },
    "functionAppSuffix": {
      "value": "${FUNCTION_APP_SUFFIX=}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP=foundry-hackathon-rg-${AZURE_ENV_NAME}}"
    },
    "foundryAccountName": {
      "value": "${FOUNDRY_RESOURCE_NAME=foundry-${AZURE_ENV_NAME}}"
    },
    "deployFoundry": {
      "value": "${DEPLOY_FOUNDRY=true}"
    },
    "existingAppInsightsConnectionString": {
      "value": "${EXISTING_APPINSIGHTS_CONNECTION_STRING=}"
    },
    "existingProjectConnectionString": {
      "value": "${EXISTING_PROJECT_CONNECTION_STRING=}"
    }
  }
}
